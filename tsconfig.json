{
    "compilerOptions": {
        "target": "es2021",
        "strict": true,
        "moduleResolution": "node16",
        "module": "node16",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["."],
    "exclude": [".yarn", "build"]
}
